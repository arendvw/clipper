<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ClipperPlugin</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <PackageId>RhinoCommands</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

</Project>